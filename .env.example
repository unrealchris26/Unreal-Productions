# ==========================================================================
# Environment variables for the booking form -> GoHighLevel integration
# --------------------------------------------------------------------------
# Copy to `.env` for local development with `netlify dev`.
# In production set these in:
#   Netlify -> Site settings -> Environment variables
#
# NEVER commit a real .env file. GHL_TOKEN grants write access to your CRM.
# ==========================================================================

# --- Required -------------------------------------------------------------

# GoHighLevel Private Integration token (recommended) or API key.
# Create at: GHL -> Settings -> Private Integrations -> Create new
# Required scopes: contacts.write, contacts.readonly
GHL_TOKEN=

# Your GHL location (sub-account) ID.
# Find at: GHL -> Settings -> Business Profile -> Location ID
GHL_LOCATION_ID=


# --- Optional: custom field IDs -------------------------------------------
# Create each custom field in GHL (Settings -> Custom Fields), then paste
# its ID here. Any field left blank is simply skipped, so the form keeps
# working before the fields exist.
#
# Suggested field types:
#   Event date          -> Date
#   Event type          -> Dropdown (or Text)
#   Event details       -> Multi-line text
#   SMS consent flags   -> Text  (stores "true" / "false")
#   Consent timestamp   -> Text  (stores an ISO-8601 timestamp)

GHL_CF_EVENT_DATE=
GHL_CF_EVENT_TYPE=
GHL_CF_EVENT_DETAILS=
GHL_CF_SMS_TRANSACTIONAL=
GHL_CF_SMS_MARKETING=
GHL_CF_CONSENT_TIMESTAMP=
